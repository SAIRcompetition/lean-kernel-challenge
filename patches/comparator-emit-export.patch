   verifyMatch challengeExport solutionExport
 
+  -- Lean Kernel Challenge extension: emit the EXACT export that was just
+  -- statement-matched, axiom-checked and kernel-replayed, so the judge can time
+  -- that immutable file instead of re-exporting (which would reopen a TOCTOU
+  -- window on the workspace .olean). No-op unless the env var is set.
+  if let some out ← IO.getEnv "COMPARATOR_SOLUTION_EXPORT" then
+    IO.FS.writeFile out solutionExport
+
   IO.println "Your solution is okay!"
 
+-- A sandboxed exporter may lie on stdout. Bind the performance declaration to
+-- the exact implementation already verified, and to the judge's direct-rfl
+-- target, before the existing kernel/axiom/timing consumers see these bytes.
+def verifyPerformance (verifiedPath perfPath : System.FilePath)
+    (target : Lean.Name) (n : Nat) (v : Int) : M Unit := do
+  let verified ← Export.parseStream (← stringStream (← IO.FS.readFile verifiedPath))
+  let perf ← Export.parseStream (← stringStream (← IO.FS.readFile perfPath))
+  IO.ofExcept <| Comparator.compareAt verified perf #[] #[] #[`Submission.impl, ``Eq, ``Eq.refl]
+  let some (.thmInfo thm) := perf.constMap[target]?
+    | throw <| IO.userError "Missing performance theorem"
+  -- The generator normalizes result type aliases to Nat/Int. The kernel
+  -- later verifies the lhs has this type; do not reject valid aliases here.
+  let some equalityType := thm.type.getAppArgs[0]?
+    | throw <| IO.userError "Invalid performance equality"
+  let some output := thm.value.getAppArgs[0]?
+    | throw <| IO.userError "Invalid direct-rfl proof"
+  let rhs ← if output == Lean.mkConst ``Nat then
+      if v < 0 then throw <| IO.userError "Negative Nat result"
+      else pure <| Lean.mkNatLit v.toNat
+    else if output == Lean.mkConst ``Int then
+      pure <| match v with
+        | .ofNat a => Lean.mkApp (Lean.mkConst ``Int.ofNat) (Lean.mkNatLit a)
+        | .negSucc a => Lean.mkApp (Lean.mkConst ``Int.negSucc) (Lean.mkNatLit a)
+    else throw <| IO.userError "Unsupported implementation output type"
+  let lhs := Lean.mkApp (Lean.mkConst `Submission.impl) (Lean.mkNatLit n)
+  let expectedType := Lean.mkApp3 (Lean.mkConst ``Eq [.succ .zero]) equalityType lhs rhs
+  let expectedProof := Lean.mkApp2 (Lean.mkConst ``Eq.refl [.succ .zero]) output rhs
+  unless thm.levelParams.isEmpty && thm.type == expectedType && thm.value == expectedProof do
+    throw <| IO.userError "Performance target is not the requested direct-rfl theorem"
+  IO.println "Performance export matches the verified implementation and requested target."
+
 structure Config where
   challenge_module : String
   solution_module : String
