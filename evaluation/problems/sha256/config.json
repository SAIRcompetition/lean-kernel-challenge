{
  "challenge_module": "Challenge",
  "solution_module": "Solution",
  "theorem_names": [
    "impl_correct"
  ],
  "definition_names": [
    "impl"
  ],
  "permitted_axioms": [
    "propext",
    "Quot.sound",
    "Classical.choice"
  ],
  "enable_nanoda": false,
  "evaluation": {
    "schema": "grouped-evaluation-v1",
    "memory_mb": 4096,
    "axis": {"label": "SHA-256 steps on an independently seeded chain", "unit": "steps", "input_encoding": "packed-v1: (steps << 32) | seed"},
    "groups": [
      {
        "id": "H1", "label": "4 steps", "order": 1,
        "sampling": {"kind": "packed", "scale": 4, "seed_bits": 32, "count": 2},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "H2", "label": "32 steps", "order": 2,
        "sampling": {"kind": "packed", "scale": 32, "seed_bits": 32, "count": 2},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "H3", "label": "512 steps", "order": 3,
        "sampling": {"kind": "packed", "scale": 512, "seed_bits": 32, "count": 2},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {"contract": "computation-total-v1", "work": "curve", "proof": "gate"}
  }
}
