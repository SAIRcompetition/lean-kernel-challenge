{
  "challenge_module": "Challenge",
  "solution_module": "Solution",
  "theorem_names": [
    "impl_correct"
  ],
  "definition_names": [
    "impl"
  ],
  "permitted_axioms": [
    "propext",
    "Quot.sound",
    "Classical.choice"
  ],
  "enable_nanoda": false,
  "evaluation": {
    "schema": "grouped-evaluation-v1",
    "memory_mb": 4096,
    "axis": {
      "label": "Fibonacci index",
      "unit": "n",
      "input_encoding": "direct Nat input"
    },
    "groups": [
      {
        "id": "F1", "label": "Small", "order": 1,
        "sampling": {"kind": "geometric_range", "min": 5000, "max": 10000, "count": 2, "jitter": 0.15},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "F2", "label": "Medium", "order": 2,
        "sampling": {"kind": "geometric_range", "min": 20000, "max": 40000, "count": 2, "jitter": 0.15},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "F3", "label": "Large", "order": 3,
        "sampling": {"kind": "geometric_range", "min": 80000, "max": 150000, "count": 2, "jitter": 0.15},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {
      "contract": "computation-total-v1",
      "work": "curve",
      "proof": "gate"
    }
  }
}
