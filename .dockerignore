results/
**/.lake/
**/*.export.ndjson
__pycache__/
.pytest_cache/
.DS_Store
.git/

# Local-only retired problem files must not enter an evaluation image.
problems/saw/
evaluation/problems/saw/
examples/submissions/saw/
rules/problems/saw.md
problems/conv/
evaluation/problems/conv/
examples/submissions/conv/
rules/problems/conv.md
scripts/gen_conv_bank.py
scripts/quick_test.py
tests/test_quick_test.py
tests/retired_saw_quick_test.py

# Local development experiments and historical review notes.
examples/prototypes/
# Exclude retired variants and negative fixtures kept only on the local checkout.
examples/submissions/
scripts/analyze_polydisc_candidates.py
scripts/benchmark_polydisc_bareiss_variants.py
scripts/benchmark_polydisc_representations.py
scripts/run_polydisc_bareiss_probe.py

# Match Git's local-only development files, retaining the image-check manifest.
tests/*
!tests/harness_manifest.json
.github/workflows/
CONTRIBUTING.md
contributing.md
scripts/sync_fib_participant.py

# Exclude local copies at retired paths; active files are under evaluation/.
/judge/
/pipeline/
/patches/
/rules/problem-scoring.md
/rules/prelaunch.md
/rules/stage1-rules.md

# Keep local root docs/assets out of images; retain the published rule logos.
/docs/
/assets/
!rules/assets/
!rules/assets/**

# Host-prebuilt verification tools (staged by scripts/prebuild-tools.sh) are
# the one exception to the .lake exclusion: they must reach the image build.
!prebuilt-tools/
!prebuilt-tools/**
