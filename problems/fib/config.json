        "limits": {"timeout_seconds": 15}
      },
      {
        "id": "F2", "label": "Medium", "order": 2,
        "sampling": {"kind": "geometric_range", "min": 50000, "max": 100000, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 10}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "F3", "label": "Large", "order": 3,
        "sampling": {"kind": "geometric_range", "min": 150000, "max": 300000, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 15}]},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "F4", "label": "Very Large", "order": 4,
        "sampling": {"kind": "geometric_range", "min": 400000, "max": 700000, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 25}]},
        "limits": {"timeout_seconds": 90}
      },
      {
        "id": "F5", "label": "Frontier", "order": 5,
        "sampling": {"kind": "geometric_range", "min": 800000, "max": 1200000, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 45}]},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {
      "contract": "group-points-v1",
      "work": "curve",
      "proof": "last_tiebreak",
      "profile": "hardest_group_then_slot"
    }
  }
