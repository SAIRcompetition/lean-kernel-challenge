{
  "challenge_module": "Challenge",
  "solution_module": "Solution",
  "theorem_names": [
    "impl_correct"
  ],
  "definition_names": [
    "impl"
  ],
  "permitted_axioms": [
    "propext",
    "Quot.sound",
    "Classical.choice"
  ],
  "enable_nanoda": false,
  "evaluation": {
    "schema": "grouped-evaluation-v1",
    "axis": {"label": "seeded fixed-row-degree matrix dimension", "unit": "dimension", "input_encoding": "packed-v1: (dimension << 32) | seed"},
    "groups": [
      {
        "id": "R1", "label": "6 x 6", "order": 1,
        "sampling": {"kind": "packed", "scale": 6, "seed_bits": 32, "count": 5},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 5, "points": 20}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "R2", "label": "12 x 12", "order": 2,
        "sampling": {"kind": "packed", "scale": 12, "seed_bits": 32, "count": 5},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 5, "points": 30}]},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "R3", "label": "16 x 16", "order": 3,
        "sampling": {"kind": "packed", "scale": 16, "seed_bits": 32, "count": 5},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 5, "points": 50}]},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {"contract": "group-points-v1", "work": "curve", "proof": "last_tiebreak", "profile": "hardest_group_then_count"}
  }
}
