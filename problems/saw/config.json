{
  "challenge_module": "Challenge",
  "solution_module": "Solution",
  "theorem_names": [
    "impl_correct"
  ],
  "definition_names": [
    "impl"
  ],
  "permitted_axioms": [
    "propext",
    "Quot.sound",
    "Classical.choice"
  ],
  "enable_nanoda": false,
  "evaluation": {
    "schema": "grouped-evaluation-v1",
    "axis": {"label": "seeded obstacle SAW length", "unit": "steps", "input_encoding": "packed-v1: (length << 32) | seed"},
    "groups": [
      {
        "id": "S1", "label": "Length 4", "order": 1,
        "sampling": {"kind": "packed", "scale": 4, "seed_bits": 32, "count": 2},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 20}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "S2", "label": "Length 6", "order": 2, "requires": ["S1"],
        "sampling": {"kind": "packed", "scale": 6, "seed_bits": 32, "count": 2},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 30}]},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "S3", "label": "Length 8", "order": 3, "requires": ["S1", "S2"],
        "sampling": {"kind": "packed", "scale": 8, "seed_bits": 32, "count": 2},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 50}]},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {"contract": "group-points-v1", "work": "total", "proof": "include", "profile": "hardest_group_then_count"}
  }
}
