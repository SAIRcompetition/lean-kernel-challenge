        "sampling": {"kind": "packed", "scale": 8, "seed_bits": 32, "count": 2},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 1, "points": 5}, {"passed": 2, "points": 10}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "H3", "label": "32 steps", "order": 3,
        "sampling": {"kind": "packed", "scale": 32, "seed_bits": 32, "count": 2},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 1, "points": 8}, {"passed": 2, "points": 16}]},
        "limits": {"timeout_seconds": 45}
      },
      {
