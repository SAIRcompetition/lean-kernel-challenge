      },
      {
        "id": "P2", "label": "Medium", "order": 2,
        "sampling": {"kind": "geometric_range", "min": 25, "max": 35, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 10}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "P3", "label": "Large", "order": 3,
        "sampling": {"kind": "geometric_range", "min": 50, "max": 100, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 15}]},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "P4", "label": "Very Large", "order": 4,
        "sampling": {"kind": "geometric_range", "min": 200, "max": 500, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 25}]},
