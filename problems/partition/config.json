{
  "challenge_module": "Challenge",
  "solution_module": "Solution",
  "theorem_names": [
    "impl_correct"
  ],
  "definition_names": [
    "impl"
  ],
  "permitted_axioms": [
    "propext",
    "Quot.sound",
    "Classical.choice"
  ],
  "enable_nanoda": false,
  "evaluation": {
    "schema": "grouped-evaluation-v1",
    "axis": {"label": "partition argument", "unit": "n", "input_encoding": "direct Nat input"},
    "groups": [
      {
        "id": "P1", "label": "Small", "order": 1,
        "sampling": {"kind": "geometric_range", "min": 8, "max": 12, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 20}]},
        "limits": {"timeout_seconds": 30}
      },
      {
        "id": "P2", "label": "Medium", "order": 2,
        "sampling": {"kind": "geometric_range", "min": 14, "max": 18, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 30}]},
        "limits": {"timeout_seconds": 60}
      },
      {
        "id": "P3", "label": "Large", "order": 3,
        "sampling": {"kind": "geometric_range", "min": 22, "max": 26, "count": 2, "jitter": 0.15},
        "award": {"mode": "milestones", "table": [{"passed": 0, "points": 0}, {"passed": 2, "points": 50}]},
        "limits": {"timeout_seconds": 120}
      }
    ],
    "ranking": {"contract": "group-points-v1", "work": "curve", "proof": "last_tiebreak", "profile": "hardest_group_then_slot"}
  }
}
