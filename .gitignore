# Build artifacts
.lake/
# Judge outputs (verdict JSONs + generated leaderboard live under results/)
results/
# Export intermediates
*.export.ndjson
# Python
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
lake-manifest.json
!problems/fib/lake-manifest.json
!evaluation/problems/fib/lake-manifest.json

# Host-prebuilt verification tools (scripts/prebuild-tools.sh)
prebuilt-tools/

# Retired problem assets stay local and are not part of the Stage 1 problem set.
/problems/saw/
/evaluation/problems/saw/
/examples/submissions/saw/
/rules/problems/saw.md
/problems/conv/
/evaluation/problems/conv/
/examples/submissions/conv/
/rules/problems/conv.md
/scripts/gen_conv_bank.py
/scripts/quick_test.py
/tests/test_quick_test.py
/tests/retired_saw_quick_test.py

# Local development experiments and historical review notes.
# Keep problem-specific tools and the evaluator's reproducible image checks.
/examples/prototypes/
# Only one public example per problem remains under examples/<id>/.
/examples/submissions/
/scripts/analyze_polydisc_candidates.py
/scripts/benchmark_polydisc_bareiss_variants.py
/scripts/benchmark_polydisc_representations.py
/scripts/run_polydisc_bareiss_probe.py

# Internal development and release administration stay local.
# The manifest is required by the Docker image's end-to-end build check.
/tests/*
!/tests/harness_manifest.json
/.github/workflows/
/CONTRIBUTING.md
/contributing.md
/scripts/sync_fib_participant.py

# Root documentation/assets stay local; published logos live in rules/assets/.
/docs/
/assets/

# Retired paths after consolidation; active files live under evaluation/ and rules/problems/.
/judge/
/pipeline/
/patches/
/rules/problem-scoring.md
/rules/prelaunch.md
/rules/stage1-rules.md
