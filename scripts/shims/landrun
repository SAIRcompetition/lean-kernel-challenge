#!/bin/sh
# landrun shim for macOS local reproduction.
# The real landrun is a Linux Landlock sandbox; it does not exist on macOS.
# This shim strips all landrun sandbox flags and execs the wrapped command
# directly. !!! NO SANDBOXING IS PERFORMED — do not use with untrusted code !!!
while [ $# -gt 0 ]; do
  case "$1" in
    --best-effort|-ldd|-add-exec) shift ;;
    --ldd|--add-exec|--unrestricted-filesystem|--unrestricted-network) shift ;;
    --ro|--rw|--rwx|--rox|--env) shift 2 ;;
    --) shift; break ;;
    --*=*) shift ;;
    --*) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
exec "$@"
